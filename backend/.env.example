PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Admin Login (change these before deploying!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourStrongPassword@2026
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRY=8h

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/zpSchoolGhorad?retryWrites=true&w=majority

# Email (optional)
SCHOOL_EMAIL=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEMPLATE_NAME=school_inquiry_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
